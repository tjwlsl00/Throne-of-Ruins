    characterSetSelectionMode: 8
    characterSequence: "[\uB85C\uADF8\uC778 \uC52C \uC77C\uBCF8\uC5B4]\r\nparkseojin\r\n\u5EC3\u865A\u306E\u738B\u5EA7\r\n\u30B9\u30BF\u30FC\u30C8\r\n\u30B2\u30FC\u30E0\u8AAC\u660E\r\n\u3088\u3046\u3053\u305D\u3001\u69D8\r\n\r\n\u57FA\u672C\u64CD\u4F5C\r\n\u30D7\u30EC\u30FC\u30E4\u30FC\u79FB\u52D5\u30AD\u30FC\r\n\u30B8\u30E3\u30F3\u30D7\u30AD\u30FC\r\n\u653B\u6483\u30AD\u30FC\r\n\u7372\u5F97\u30AD\u30FC\r\n\uFF0A\u30E2\u30F3\u30B9\u30BF\u30FC\u3092\u5012\u3057\u305F\u5F8C\u3001\u304A\u91D1\u3092\u62FE\u3046\u306E\u306B\u4F7F\u308F\u308C\u307E\u3059\r\n\u30A4\u30F3\u30D9\u30F3\u30C8\u30EA\u30FC\r\n\u76F8\u4E92\u4F5C\u7528\r\n\uFF0ANPC\u3068\u76F8\u4E92\u4F5C\u7528\u3059\u308B\u6642\u3001\u4F7F\u308F\u308C\u307E\u3059\r\n\u6B21\u3078\r\nX\r\n\r\n\u30D7\u30EC\u30FC\u30E4\u30FC\u30B7\u30B9\u30C6\u30E0\r\n\u30B9\u30C6\u30FC\u30BF\u30B9\u30B7\u30B9\u30C6\u30E0\r\n\uFF0A\u30EC\u30D9\u30EB\u30A2\u30C3\u30D7\u5F8C\u3001\u6E9C\u307E\u3063\u305F\u30DD\u30A4\u30F3\u30C8\u3092\u4F7F\u3046\u3053\u3068\u3067\u30B9\u30C6\u30FC\u30BF\u30B9\u3092\u4E0A\u3052\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\r\n\u88C5\u5099\u30B7\u30B9\u30C6\u30E0\r\n\uFF0ANPC\u304B\u3089\u8CB7\u3063\u305F\u88C5\u5099\u3092\u88C5\u7740\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\r\n\u30A4\u30F3\u30D9\u30F3\u30C8\u30EA\u30FC\r\n\uFF0A\u7372\u5F97\u3057\u305F\u30A2\u30A4\u30C6\u30E0\uFF08\u88C5\u5099\u3001
      \u30DD\u30FC\u30B7\u30E7\u30F3\uFF09\u3092\u95B2\u89A7\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\r\n\r\n\u6575\u30AA\u30D6\u30B8\u30A7\u30AF\u30C8\r\n\u30A6\u30A3\u30B6\u30FC\u30C9\r\n\u30B4\u30D6\u30EA\u30F3\r\n\uFF0A\u57FA\u672C\u7684\u306B\u30C0\u30F3\u30B8\u30E7\u30F3\u304B\u3089\u51FA\u73FE\u3057\u307E\u3059\r\n\u5012\u3059\u3053\u3068\u3067\u4E00\u5B9A\u91CF\u306E\u304A\u91D1\u3068EXP\u3092\u5F97\u308B\u3053\u3068\u304C\u3067\u304D\u3001\u4E00\u5B9A\u306E\u6642\u9593\u304C\u7ACB\u3063\u305F\u3089\u307E\u305F\u30EA\u30B9\u30DD\u30F3\u3057\u307E\u3059\u3002\r\n\u60AA\u9B54\u306E\u9B54\u6CD5\u4F7F\u3044\r\n\u30DC\u30FC\u30B9\r\n\uFF0A\u30D5\u30A7\u30FC\u30BA3\u307E\u3067\u30DC\u30FC\u30B9\u306E\u653B\u6483\u3092\u907F\u3051\u306A\u304C\u3089\u5012\u3059\u306E\u304C\u30DD\u30A4\u30F3\u30C8\u3067\u3059\r\n\uFF08\u6B7B\u4EA1\u3057\u5834\u5408\u3001\u753A\u3078\u79FB\u52D5\u3057\u307E\u3059\uFF09\r\n\r\n[\uB9C8\uC744
      \uC77C\uBCF8\uC5B4]\r\n\r\n\uC655, \uD50C\uB808\uC774\uC5B4 \uB300\uC0AC \r\n\"\u2026\u541B\u3060\u306A\u3002\u3053\u3093\u306A\u3080\u3055\u304F\u308B\u3057\u3044\u6240\u307E\u3067\u6765\u3055\u305B\u3066\u3059\u307E\u306A\u3044\"\r\n\uFF08\u81EA\u5632\u7684\u306B\u7B11\u3063\u3066\uFF09\"\u738B\u3068\u547C\u3070\u308C\u308B\u8CC7\u683C\u3082\u306A\u3044\u3002
      \u6C11\u4E00\u4EBA\u5B88\u308C\u305A\u3001\u3053\u306E\u6709\u69D8\u306B\u306A\u3063\u305F\u306E\u3060\u304B\u3089\u2026\u6BCE\u6669\u3001\u602A\u7269\u305F\u3061\u306B\u6D88\u3048\u3066\u3044\u3063\u305F\u5F7C\u3089\u306E\u60B2\u9CF4\u304C\u8033\u5143\u306B\u6B8B\u308B\u3002\"\r\n\"\u60AA\u3044\u3051\u3069\u3001\u9577\u304F\u306F\u8A00\u308F\u306A\u3044\u3088\u3002
      \u541B\u306E\u5B9F\u529B\u306B\u3064\u3044\u3066\u306F\u3088\u304F\u805E\u3044\u305F\u3088\u3002
      \u4ECA\u3001\u79C1\u305F\u3061\u306B\u306F\u541B\u306E\u3088\u3046\u306A\u529B\u304C\u5207\u5B9F\u306B\u5FC5\u8981\u3060\"
      \r\n\uFF08\u5730\u56F3\u306E\u7279\u5B9A\u306E\u5730\u57DF\u3092\u6307\u3057\u3066\uFF09\"\u3084\u3064\u3089\u306F\u3053\u306E\u5468\u8FBA\u306B\u307E\u3060\u6CB8\u304D\u7ACB\u3063\u3066\u3044\u308B\u3002
      \u3042\u3044\u3064\u3089\u3092\u3084\u3063\u3064\u3051\u306A\u3044\u9650\u308A\u3001\u518D\u5EFA\u306A\u3093\u3066\u5922\u306B\u3082\u601D\u308F\u306A\u3044\u3088\u3002
      \u751F\u304D\u6B8B\u3063\u305F\u308F\u305A\u304B\u306A\u6C11\u3055\u3048\u5E0C\u671B\u3092\u5931\u3044\u3064\u3064\u3042\u308B\"
      \r\n\r\n\uFF08\u738B\u3092\u3058\u3063\u3068\u898B\u3064\u3081\u306A\u304C\u3089\uFF09
      \"\u2026\u965B\u4E0B\u304C\u76F4\u63A5\u304A\u8FCE\u3048\u306B\u6765\u3089\u308C\u308B\u3068\u306F\u77E5\u308A\u307E\u305B\u3093\u3067\u3057\u305F\u3002\"\r\n\"\u2026\u2026.\"
      (\u4E3B\u4EBA\u516C\u306F\u9ED9\u3063\u3066\u738B\u306E\u8A00\u3046\u3053\u3068\u3092\u805E\u304F)\r\n\"\u72B6\u6CC1\u306F\u4F3A\u3044\u307E\u3057\u305F\u3002
      \u79C1\u306E\u3084\u308B\u3053\u3068\u3092\u6559\u3048\u3066\u304F\u3060\u3055\u3044\"
      \r\n\uFF08\u5730\u56F3\u3092\u773A\u3081\u308B\u3001\u6C7A\u5FC3\u3057\u305F\u3088\u3046\u306B\u738B\u3092\u898B\u308B\uFF09
      \"\u2026\u4E86\u89E3\u81F4\u3057\u307E\u3057\u305F\u3002 \u4EFB\u305B\u3066\u304F\u3060\u3055\u3044\u3002\"\r\n\r\n\uC7A5\uBE44
      \uC0C1\uC778 \uB300\uC0AC \r\n\u6B66\u5668\u5546\u4EBA\r\n\"...\u541B\u307F\u305F\u3044\u306A\u76EE\u3092\u3057\u305F\u4EBA\u306F\u4E45\u3057\u3076\u308A\u3060\u306D\u3002\u3082\u3046\u4F7F\u3048\u308B\u88C5\u5099\u3082\u307B\u3068\u3093\u3069\u6B8B\u3063\u3066\u3044\u306A\u3044\u304C....
      \u3069\u3046\u304B\u3053\u306E\u88C5\u5099\u3067\u79C1\u305F\u3061\u306E\u5FA9\u8B90\u3092\u3001\u3044\u3084...\u738B\u56FD\u306E\u672A\u6765\u3092\u53D6\u308A\u623B\u3057\u3066\u304F\u308C\"\r\n\r\n\r\n\uBB3C\uC57D
      \uC0C1\uC778 \uB300\uC0AC \r\n\u96D1\u8CA8\u5546\u4EBA\r\n\"\u3044\u3089\u3063\u3057\u3083\u3044\u307E\u305B\u3002
      \u3053\u3093\u306A\u306B\u5909\u308F\u3063\u3066\u3057\u307E\u3063\u305F\u6240\u307E\u3067\u6765\u3066\u304F\u3060\u3055\u308B\u306A\u3093\u3066...\u7C97\u54C1\u3067\u3059\u304C\u3001\u304F\u308C\u3050\u308C\u3082\u304A\u4F53\u3092\u5927\u5207\u306B\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u3042\u306A\u305F\u306F\u3082\u3046\u3053\u306E\u738B\u56FD\u306E\u6700\u5F8C\u306E\u5E0C\u671B\u3067\u3059\u304B\u3089\"\r\n\u8CFC\u5165\r\n\u5B8C\u4E86\uFF01\r\n\u5931\u6557\r\n\r\n\"\u3042\u306A\u305F\u306F\u52C7\u8005\u69D8\u2026\u3054\u6B66\u904B\u3092\u7948\u308A\u307E\u3059\"\r\n\r\n[\uB9F5
      \uAD00\uB828]\r\n\u73FE\u5728\u4F4D\u7F6E\r\n\u68EE\r\n\u30A8\u30F3\u30C8\u30E9\u30F3\u30B9\r\n\r\n[\uD50C\uB808\uC774\uC5B4
      \uAD00\uB828]\r\n\u30B9\u30ED\u30C3\u30C8\u306B\u767B\u9332\r\n(\u5229\u7528\u53EF)\r\n\u30EA\u30BB\u30C3\u30C8\r\n\u6B8B\u9AD8\r\n\u753A\u3067\u5FA9\u6D3B\u3059\u308B\r\n\u5BFE\u8A71\r\n\r\n[Entrance\uB9F5
      \uB300\uC0AC]\r\n\u3042\u306E\u602A\u7269\xB7\xB7\xB7 \u4E00\u4EBA\u3067\u306F\u7D76\u5BFE\u52DD\u3066\u306A\u3044\u3002
      \u3067\u3082\u4ECA\u306E\u3042\u306A\u305F\u306A\u3089--\uFF01\r\n\xB7\xB7\xB7
      \u305D\u306E\u81EA\u4FE1\u3001\u3055\u3059\u304C\u52C7\u8005\u3060\u306A\uFF01
      \u6B7B\u306C\u524D\u306B\u4E00\u5EA6\u540D\u524D\u3092\u547C\u3093\u3067\u3084\u308B\u30FC\u30FC\uFF01\r\n\u541B\u306F\u76FE\u3001\u4FFA\u306F\u69CD\u306B\u306A\u308B\r\n\u540D\u524D\u306A\u3093\u304B\u8981\u3089\u306A\u3044\u3002
      \u4ECA\u65E5\u2026\xB7\xB7\xB7 \u4FFA\u305F\u3061\u306F\u82F1\u96C4\u306B\u306A\u308B\u304B\u3089\r\n\u738B\u56FD\u306E\u9A0E\u58EB\u56E3\u9577\r\n\r\n\uFF1A\r\n\r\n\r\n[\uBCF4\uC2A4
      \uAD00\uB828]\r\n\u79D2 \u7D42 \u6311\r\n\r\n\r\n\uB9C8\uC9C0\uB9C9\uC52C\r\n(\u606F\u3092\u6BBA\u3057\u305F\u58F0\u3067)\r\n\"\u52C7\u8005\u3088\uFF01\u305D\u306E\u2026\u305E\u3063\u3068\u3057\u305F\u602A\u7269\u306F\u2026\uFF1F\"\r\n(\u56FA\u3044\u58F0\u3067\u738B\u3092\u632F\u308A\u8FD4\u308A\u306A\u304C\u3089\u77ED\u304F\u7B54\u3048\u308B)\r\n\"\u3082\u3046\u738B\u56FD\u306F\u5B89\u5168\u3067\u3059\u3002
      \u60AA\u9B54\u306E\u9B54\u6CD5\u4F7F\u3044\u306F\u5012\u308C\u307E\u3057\u305F\"\r\n\"\u304A\u304A\u2026\uFF01\u304A\u304A\u3001\u795E\u69D8\uFF01
      \u3042\u306A\u305F\u306E\u76EE\u3092\u898B\u305F\u3089\u5206\u304B\u308A\u307E\u3057\u305F\uFF01
      \u3053\u306E\u5730\u3092\u8986\u3063\u305F\u7D76\u671B\u306E\u5F71\u304C\u3064\u3044\u306B\u6674\u308C\u307E\u3057\u305F\u306D\uFF01\"\r\n\r\n(\u304B\u3059\u304B\u306B\u5FAE\u7B11\u3093\u3067)\r\n\"\u305D\u3046\u3067\u3059\u3001\u965B\u4E0B\u3002
      \u95C7\u306F\u53BB\u308A\u307E\u3057\u305F\u3002 \u3082\u3046\u4E00\u5EA6\u59CB\u3081\u308B\u6642\u9593\u3067\u3059\"\r\n(\u8FBC\u307F\u4E0A\u3052\u308B\u611F\u60C5\u3092\u6301\u3066\u4F59\u3057\u3066)\r\n\"\u305D\u3046\u3067\u3059\uFF01\u307E\u3055\u306B\u305D\u308C\u3067\u3059\uFF01
      \u3042\u306A\u305F\u306E\u52DD\u5229\u304C\u307E\u3055\u306B\u738B\u56FD\u518D\u5EFA\u306E\u6700\u521D\u306E\u591C\u660E\u3051\u3092\u958B\u3044\u305F\u306E\u3060\uFF01
      \u306A\u3093\u3066\u5F85\u3063\u3066\u3044\u305F\u77AC\u9593\u306A\u3093\u3060\u308D\u3046\uFF01\"\r\n(\u3046\u306A\u305A\u304F)\r\n(\u4E3B\u4EBA\u516C\u306E\u80A9\u3092\u529B\u3044\u3063\u3071\u3044\u3064\u304B\u3080)\r\n\"\u65E9\u304F\u6C11\u306B\u4F1D\u3048\u307E\u3057\u3087\u3046\uFF01
      \u5E0C\u671B\u304C\u623B\u3063\u3066\u304D\u305F\u3063\u3066\uFF01 \u79C1\u305F\u3061\u304C\u52DD\u5229\u3057\u305F\u3068\uFF01\"\r\n\"\u559C\u3093\u3067\u3001\u965B\u4E0B\u3068\u5171\u306B\u5E0C\u671B\u3092\u7BC9\u304D\u307E\u3059\"\r\n\r\n\u59EB\r\n\r\n\u521D\u3081\u307E\u3057\u3066\uFF01\u52C7\u8005\u2026\r\n\u3054\u7121\u4E8B\u3067\u306A\u306B\u3088\u308A\u3067\u3059\r\n\u597D\u304D\r\n\u6642\u304C\u305F\u3064\u306B\u3064\u308C\u3066\u738B\u56FD\u306F\u5E73\u548C\u3092\u53D6\u308A\u623B\u3057,
      \u52C7\u8005\u306F\u304A\u59EB\u3068\u5A5A\u7D04\u3059\u308B\u3088\u3046\u306B\u306A\u308A\u306A\u304C\u3089\u52C7\u8005\u306E\u7269\u8A9E\u306F\u7D42\u308F\u308B\u3002\r\n\r\n"
