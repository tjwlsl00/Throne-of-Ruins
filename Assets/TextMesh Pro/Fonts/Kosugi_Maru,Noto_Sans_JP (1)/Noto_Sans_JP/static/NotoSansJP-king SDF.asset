    characterSetSelectionMode: 8
    characterSequence: "\"\u2026\u541B\u3060\u306A\u3002\u3053\u3093\u306A\u3080\u3055\u304F\u308B\u3057\u3044\u6240\u307E\u3067\u6765\u3055\u305B\u3066\u3059\u307E\u306A\u3044\"\r\n\uFF08\u81EA\u5632\u7684\u306B\u7B11\u3063\u3066\uFF09\"\u738B\u3068\u547C\u3070\u308C\u308B\u8CC7\u683C\u3082\u306A\u3044\u3002
      \u6C11\u4E00\u4EBA\u5B88\u308C\u305A\u3001\u3053\u306E\u6709\u69D8\u306B\u306A\u3063\u305F\u306E\u3060\u304B\u3089\u2026\u6BCE\u6669\u3001\u602A\u7269\u305F\u3061\u306B\u6D88\u3048\u3066\u3044\u3063\u305F\u5F7C\u3089\u306E\u60B2\u9CF4\u304C\u8033\u5143\u306B\u6B8B\u308B\u3002\"\r\n\"\u60AA\u3044\u3051\u3069\u3001\u9577\u304F\u306F\u8A00\u308F\u306A\u3044\u3088\u3002
      \u541B\u306E\u5B9F\u529B\u306B\u3064\u3044\u3066\u306F\u3088\u304F\u805E\u3044\u305F\u3088\u3002
      \u4ECA\u3001\u79C1\u305F\u3061\u306B\u306F\u541B\u306E\u3088\u3046\u306A\u529B\u304C\u5207\u5B9F\u306B\u5FC5\u8981\u3060\"
      \r\n\uFF08\u5730\u56F3\u306E\u7279\u5B9A\u306E\u5730\u57DF\u3092\u6307\u3057\u3066\uFF09\"\u3084\u3064\u3089\u306F\u3053\u306E\u5468\u8FBA\u306B\u307E\u3060\u6CB8\u304D\u7ACB\u3063\u3066\u3044\u308B\u3002
      \u3042\u3044\u3064\u3089\u3092\u3084\u3063\u3064\u3051\u306A\u3044\u9650\u308A\u3001\u518D\u5EFA\u306A\u3093\u3066\u5922\u306B\u3082\u601D\u308F\u306A\u3044\u3088\u3002
      \u751F\u304D\u6B8B\u3063\u305F\u308F\u305A\u304B\u306A\u6C11\u3055\u3048\u5E0C\u671B\u3092\u5931\u3044\u3064\u3064\u3042\u308B\"
      \r\n\r\n\uFF08\u738B\u3092\u3058\u3063\u3068\u898B\u3064\u3081\u306A\u304C\u3089\uFF09
      \"\u2026\u965B\u4E0B\u304C\u76F4\u63A5\u304A\u8FCE\u3048\u306B\u6765\u3089\u308C\u308B\u3068\u306F\u77E5\u308A\u307E\u305B\u3093\u3067\u3057\u305F\u3002\"\r\n\"\u2026\u2026.\"
